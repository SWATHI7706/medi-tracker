# Medi-Tracker Backend Environment Configuration Template

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=medi_tracker

# JWT Security (Generate a strong secret in production, e.g. using `openssl rand -hex 32`)
JWT_SECRET=your-production-jwt-secret-key-change-me

# CORS Allowed Origins (Comma-separated list of origins permitted to call this API)
# In production, set this to your frontend URL(s), e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# File Storage Directory (Optional: customize for persistent cloud disk storage)
# UPLOAD_DIR=/data/uploads

# Port (Optional: Defaults to 8000 or the PORT variable provided by cloud hosts like Render/Railway/Heroku)
PORT=8000
